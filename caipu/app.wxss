page {
  background: #F2F2F7;
  font-family: -apple-system, 'PingFang SC', sans-serif;
  color: #1C1C1E;
  font-size: 30rpx;
  line-height: 1.5;
}

/* 全局卡片 */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 28rpx;
  margin: 16rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 主按钮 */
.btn-primary {
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  margin: 20rpx 28rpx;
}

/* 次要按钮 */
.btn-secondary {
  background: #FFFFFF;
  color: #007AFF;
  border: 2rpx solid #E5E5EA;
  border-radius: 24rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  margin: 20rpx 28rpx;
}

/* 搜索框 */
.search-bar {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 28rpx;
  margin: 20rpx 28rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid #E5E5EA;
}
.search-bar input {
  flex: 1;
  font-size: 30rpx;
}

/* 分段标签 */
.segment-wrap {
  display: flex;
  white-space: nowrap;
  padding: 0 28rpx;
  margin-bottom: 10rpx;
}
.segment-wrap .seg {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  color: #8E8E93;
  font-size: 26rpx;
  margin-right: 16rpx;
  border: 2rpx solid #E5E5EA;
}
.segment-wrap .seg.active {
  background: #007AFF;
  color: #FFFFFF;
  border-color: #007AFF;
}

/* 文字工具 */
.tc { text-align: center; }
.muted { color: #8E8E93; font-size: 26rpx; }
.red { color: #FF3B30; }
.green { color: #34C759; }
.blue { color: #007AFF; }

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E5E5EA;
  display: flex;
  gap: 20rpx;
}

/* FAB 悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,122,255,0.38);
  z-index: 100;
}
