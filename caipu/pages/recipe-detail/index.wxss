.cover-img {
  width: 100%;
  height: 420rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-card {
  background: #FFFFFF;
  padding: 32rpx 28rpx;
  margin: -32rpx 28rpx 20rpx;
  border-radius: 32rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.header-tags { display: flex; gap: 16rpx; margin-bottom: 16rpx; align-items: center; }
.cate-tag {
  background: #007AFF15;
  color: #007AFF;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.info { font-size: 24rpx; color: #8E8E93; }
.recipe-title { font-size: 44rpx; font-weight: 800; color: #1C1C1E; display: block; margin-bottom: 8rpx; }
.main-info { font-size: 28rpx; color: #8E8E93; }

/* 模式切换 */
.mode-toggle {
  display: flex;
  margin: 0 28rpx 16rpx;
  background: #E5E5EA;
  border-radius: 24rpx;
  padding: 6rpx;
}
.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #8E8E93;
  font-weight: 500;
}
.mode-btn.on {
  background: #FFFFFF;
  color: #007AFF;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* 换算区 */
.scale-card {
  padding: 28rpx;
}
.scale-label { font-size: 28rpx; color: #8E8E93; display: block; margin-bottom: 16rpx; }
.scaler {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.scaler-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F2F2F7;
  font-size: 44rpx;
  line-height: 72rpx;
  text-align: center;
  color: #007AFF;
  font-weight: 600;
}
.scaler-input {
  width: 120rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 800;
  color: #1C1C1E;
  border-bottom: 4rpx solid #007AFF;
  padding: 8rpx 0;
}
.scaler-input.w { width: 180rpx; font-size: 40rpx; }
.weight-input {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #8E8E93;
  margin-bottom: 16rpx;
}
.scale-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #8E8E93;
}

/* 配料 */
.card-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.reset-btn { font-size: 26rpx; color: #007AFF; font-weight: 400; }

.ing-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}
.ing-item:last-child { border-bottom: none; }
.ing-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.ing-name { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.lock-btn { font-size: 28rpx; padding: 4rpx; }
.lock-btn.locked { opacity: 0.5; }

.ing-bottom {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
}
.amount-input {
  width: 100rpx;
  border: 2rpx solid #E5E5EA;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  font-size: 28rpx;
  text-align: center;
}
.ing-unit { color: #8E8E93; }
.ing-price { color: #8E8E93; }
.ing-cost { color: #FF3B30; font-weight: 600; }

/* 成本 */
.cost-summary {
  display: flex;
  gap: 20rpx;
  margin: 16rpx 28rpx;
}
.cost-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  text-align: center;
}
.cost-label { font-size: 26rpx; color: #8E8E93; display: block; }
.cost-val.total { font-size: 48rpx; font-weight: 800; color: #FF3B30; display: block; margin-top: 8rpx; }
.cost-val.per { font-size: 42rpx; font-weight: 700; color: #1C1C1E; display: block; margin-top: 8rpx; }

/* 步骤 */
.step-section { margin-bottom: 20rpx; }
.step {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}
.step:last-child { border-bottom: none; }
.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  flex-shrink: 0;
}
.step-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #3A3A3C; }
