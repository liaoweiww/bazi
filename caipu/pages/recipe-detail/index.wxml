<scroll-view class="page" scroll-y wx:if="{{recipe}}">
  <!-- 封面大图 -->
  <image class="cover-img" src="{{recipe.cover_image || '/images/icon-add.png'}}" mode="aspectFill"/>

  <!-- 头部信息 -->
  <view class="header-card">
    <view class="header-tags">
      <text class="cate-tag">{{recipe.category}}</text>
      <text class="info">⏱ {{recipe.cook_time}}分钟</text>
      <text class="info">⭐ {{recipe.difficulty}}</text>
      <text class="info">{{recipe.base_person}}人份</text>
    </view>
    <text class="recipe-title">{{recipe.name}}</text>
    <text class="main-info">主料：{{recipe.main_material}} {{recipe.main_weight}}{{recipe.main_unit}}</text>
  </view>

  <!-- 双模式切换 -->
  <view class="mode-toggle">
    <view class="mode-btn {{scaleMode === 'person' ? 'on' : ''}}" data-mode="person" bindtap="onModeSwitch">
      按人头换算
    </view>
    <view class="mode-btn {{scaleMode === 'weight' ? 'on' : ''}}" data-mode="weight" bindtap="onModeSwitch">
      按重量换算
    </view>
  </view>

  <!-- 模式A：按人头 -->
  <view class="card scale-card" wx:if="{{scaleMode === 'person'}}">
    <text class="scale-label">用餐人数</text>
    <view class="scaler">
      <view class="scaler-btn" bindtap="onPersonMinus">−</view>
      <input class="scaler-input" type="number" value="{{targetPerson}}" bindinput="onPersonInput"/>
      <view class="scaler-btn" bindtap="onPersonPlus">+</view>
    </view>
    <text class="scale-hint">
      倍率：{{scale}}x · 基准 {{recipe.base_person}} 人 → {{targetPerson}} 人
    </text>
  </view>

  <!-- 模式B：按重量 -->
  <view class="card scale-card" wx:if="{{scaleMode === 'weight'}}">
    <text class="scale-label">
      基准：{{recipe.main_material}} {{recipe.main_weight}}{{recipe.main_unit}} = {{recipe.base_person}}人份
    </text>
    <view class="weight-input">
      <text>实际买回重量：</text>
      <input class="scaler-input w" type="digit" value="{{targetWeight}}" bindinput="onWeightInput"/>
      <text>{{recipe.main_unit}}</text>
    </view>
    <text class="scale-hint">
      倍率：{{scale}}x · 预估 {{estimatedPeople}} 人份
    </text>
  </view>

  <!-- 配料表 -->
  <view class="card">
    <view class="card-title">
      <text>配料清单</text>
      <text class="reset-btn" bindtap="resetScale">重置</text>
    </view>
    <block wx:for="{{ingredients}}" wx:key="id">
      <view class="ing-item">
        <view class="ing-top">
          <text class="ing-name">{{item.material_name}}</text>
          <text class="lock-btn {{item.is_locked ? 'locked' : ''}}" data-id="{{item.id}}" bindtap="onLockToggle">
            {{item.is_locked ? '🔒' : '🔓'}}
          </text>
        </view>
        <view class="ing-bottom">
          <input class="amount-input" type="digit" value="{{item.scaled_amount}}"
                 data-id="{{item.id}}" bindinput="onIngAmountChange"/>
          <text class="ing-unit">{{item.unit}}</text>
          <text class="ing-price">× ¥{{item.price_per_unit}}/斤</text>
          <text class="ing-cost">= ¥{{item.single_cost}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 成本汇总 -->
  <view class="cost-summary">
    <view class="cost-item">
      <text class="cost-label">总成本</text>
      <text class="cost-val total">¥{{totalCost}}</text>
    </view>
    <view class="cost-item">
      <text class="cost-label">人均</text>
      <text class="cost-val per">¥{{perPersonCost}}</text>
    </view>
  </view>

  <!-- 做法步骤 -->
  <view class="card step-section">
    <view class="card-title" bindtap="onToggleSteps">
      <text>做法步骤</text>
      <text>{{showSteps ? '收起' : '展开'}}</text>
    </view>
    <block wx:if="{{showSteps}}">
      <block wx:for="{{steps}}" wx:key="id">
        <view class="step">
          <view class="step-num">{{index + 1}}</view>
          <text class="step-text">{{item.content}}</text>
        </view>
      </block>
    </block>
  </view>

  <view style="height:160rpx"></view>
</scroll-view>

<!-- 底部操作 -->
<view class="bottom-bar">
  <button class="btn-secondary" style="flex:1;margin:0;" bindtap="resetScale">重置配方</button>
  <button class="btn-primary" style="flex:1;margin:0;" bindtap="onMore">更多</button>
</view>
