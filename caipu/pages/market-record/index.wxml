<scroll-view class="page" scroll-y>
  <view style="padding: 0 28rpx;">

    <view class="section-title">快速记价</view>

    <view wx:if="{{material}}" class="card center-card">
      <text class="big-name">{{material.material_name}}</text>
      <text class="sub-text">{{material.default_unit}}</text>
    </view>

    <!-- 超大价格输入 -->
    <view class="card price-card">
      <text class="yuan">¥</text>
      <input class="big-input" type="digit" placeholder="0.00" value="{{price}}"
             bindinput="onInput" data-field="price" focus="true"/>
      <text class="per-unit">/{{unit}}</text>
    </view>

    <!-- 单位 -->
    <view class="card">
      <text class="label">单位</text>
      <view class="unit-wrap">
        <text wx:for="{{units}}" wx:key="*this"
              data-field="unit" data-val="{{item}}" bindtap="onSelectTap"
              class="unit {{unit === item ? 'on' : ''}}">{{item}}</text>
      </view>
    </view>

    <!-- 日期 -->
    <view class="card">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="date-pick">{{date}}</view>
      </picker>
    </view>

    <!-- 地点 -->
    <view class="card">
      <text class="label">购买地点</text>
      <view class="place-wrap">
        <text wx:for="{{places}}" wx:key="*this"
              data-field="place" data-val="{{item}}" bindtap="onSelectTap"
              class="place {{place === item ? 'on' : ''}}">{{item}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <text class="label">备注</text>
      <input class="input" placeholder="如：品质不错" value="{{remark}}"
             bindinput="onInput" data-field="remark"/>
    </view>

    <view style="height:180rpx"></view>
  </view>
</scroll-view>

<view class="bottom-bar">
  <button class="btn-primary" style="flex:1;margin:0;" bindtap="save">保存记价</button>
</view>
