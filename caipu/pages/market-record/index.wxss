.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  padding: 32rpx 0 16rpx 4rpx;
}
.center-card { text-align: center; padding: 32rpx; }
.big-name { font-size: 48rpx; font-weight: 800; color: #1C1C1E; display: block; }
.sub-text { font-size: 28rpx; color: #8E8E93; margin-top: 8rpx; display: block; }

/* 超大价格 */
.price-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 32rpx 28rpx;
}
.yuan { font-size: 56rpx; font-weight: 800; color: #FF3B30; }
.big-input {
  font-size: 80rpx;
  font-weight: 800;
  color: #1C1C1E;
  text-align: center;
  border-bottom: 6rpx solid #007AFF;
  min-width: 200rpx;
  padding: 8rpx 12rpx;
  max-width: 400rpx;
}
.per-unit { font-size: 36rpx; color: #8E8E93; }

.label { font-size: 28rpx; color: #8E8E93; margin-bottom: 12rpx; display: block; }

.unit-wrap { display: flex; gap: 12rpx; }
.unit { padding: 12rpx 28rpx; border-radius: 20rpx; background: #F2F2F7; font-size: 26rpx; color: #8E8E93; }
.unit.on { background: #007AFF; color: #fff; }

.date-pick {
  border: 2rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  background: #F9F9FB;
}

.place-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.place {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  font-size: 26rpx;
  color: #8E8E93;
}
.place.on { background: #007AFF; color: #fff; }

.input { border: 2rpx solid #E5E5EA; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 30rpx; background: #F9F9FB; }
