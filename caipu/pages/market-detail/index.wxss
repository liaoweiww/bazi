.header-card {
  background: #FFFFFF;
  padding: 32rpx 28rpx;
  margin: 20rpx 28rpx;
  border-radius: 32rpx;
}
.mat-name { font-size: 44rpx; font-weight: 800; color: #1C1C1E; display: block; margin-bottom: 12rpx; }
.mat-meta { display: flex; gap: 12rpx; }
.meta-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: #F2F2F7;
  color: #8E8E93;
}

.analysis-bar {
  margin: 0 28rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
}
.ana-text { font-size: 30rpx; font-weight: 600; }

/* Tabs */
.tab-bar {
  display: flex;
  margin: 0 28rpx 16rpx;
  background: #E5E5EA;
  border-radius: 20rpx;
  padding: 6rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #8E8E93;
}
.tab.on { background: #FFFFFF; color: #007AFF; font-weight: 700; }

/* 曲线 */
.chart-card {
  padding: 24rpx 28rpx;
}
.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  display: block;
  margin-bottom: 20rpx;
}
.chart-container {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  gap: 2rpx;
}
.bar-wrap { display: flex; align-items: flex-end; height: 100%; }
.bar-fill { width: 100%; min-width: 4rpx; }
.chart-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8E8E93;
}
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; display: inline-block; }
.dot.blue { background: #007AFF; }
.dot.orange { background: #FF9500; }
.chart-empty { text-align: center; padding: 60rpx 0; }

/* 统计 */
.stats-card {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
}
.stat-item {
  flex: 1 1 28%;
  min-width: 120rpx;
  text-align: center;
  padding: 12rpx;
}
.stat-label { font-size: 24rpx; color: #8E8E93; display: block; }
.stat-val { font-size: 32rpx; font-weight: 700; color: #1C1C1E; display: block; margin-top: 6rpx; }

/* 记录 */
.record-item {
  padding: 24rpx 28rpx;
}
.rec-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rec-price { font-size: 36rpx; font-weight: 700; color: #FF3B30; }
.rec-date { font-size: 26rpx; color: #8E8E93; }
.rec-bottom {
  margin-top: 10rpx;
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: #8E8E93;
}
