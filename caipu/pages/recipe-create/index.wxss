.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  padding: 32rpx 0 16rpx 4rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.add-link {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 400;
}

.field {
  padding: 12rpx 0;
}
.label {
  font-size: 28rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
  display: block;
}
.input {
  border: 2rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  background: #F9F9FB;
}
.input.num {
  width: 120rpx;
}
.input.sm {
  width: 130rpx;
  font-size: 26rpx;
  padding: 12rpx 14rpx;
}
.field-row {
  display: flex;
  gap: 24rpx;
}
.field.half {
  flex: 1;
}

.stars { display: flex; gap: 8rpx; padding-top: 8rpx; }
.star { font-size: 40rpx; color: #E5E5EA; }
.star.on { color: #FF9500; }

.seg-wrap { white-space: nowrap; padding: 8rpx 0; }
.seg {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  background: #F2F2F7;
  color: #8E8E93;
}
.seg.active { background: #007AFF; color: #fff; }

.unit-wrap { display: flex; gap: 12rpx; padding-top: 8rpx; }
.unit {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  font-size: 26rpx;
  color: #8E8E93;
}
.unit.on { background: #007AFF; color: #fff; }

.ing-row, .step-row {
  padding: 20rpx 24rpx;
}
.ing-header, .step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.ing-num, .step-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #007AFF;
}
.del { font-size: 26rpx; color: #FF3B30; }
.ing-row-3 {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.textarea {
  border: 2rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #F9F9FB;
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 表单通用字段切换 */
.onFieldTap {
  cursor: pointer;
}
