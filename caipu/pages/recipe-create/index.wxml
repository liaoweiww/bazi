<scroll-view class="page" scroll-y>
  <view style="padding: 0 28rpx;">

    <!-- 基础信息 -->
    <view class="section-title">基础信息</view>
    <view class="card">
      <view class="field">
        <text class="label">菜名 *</text>
        <input class="input" placeholder="输入菜名" value="{{name}}" bindinput="onFieldInput" data-field="name"/>
      </view>
      <view class="field">
        <text class="label">分类</text>
        <scroll-view class="seg-wrap" scroll-x>
          <text class="seg {{category === item ? 'active' : ''}}"
                wx:for="{{categories}}" wx:key="*this"
                data-field="category" data-val="{{item}}" bindtap="onFieldTap">{{item}}</text>
        </scroll-view>
      </view>
      <view class="field-row">
        <view class="field half">
          <text class="label">耗时(分)</text>
          <input class="input num" type="number" value="{{cookTime}}" bindinput="onFieldInput" data-field="cookTime"/>
        </view>
        <view class="field half">
          <text class="label">难度</text>
          <view class="stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
                  data-field="difficulty" data-val="{{item}}" bindtap="onFieldTap"
                  class="star {{item <= difficulty ? 'on' : ''}}">{{item <= difficulty ? '★' : '☆'}}</text>
          </view>
        </view>
      </view>
      <view class="field">
        <text class="label">基准人数</text>
        <input class="input num" type="number" value="{{basePerson}}" bindinput="onFieldInput" data-field="basePerson"/>
      </view>
    </view>

    <!-- 主料 -->
    <view class="section-title">核心主料</view>
    <view class="card">
      <view class="field">
        <text class="label">主料名称</text>
        <input class="input" placeholder="如：猪五花肉" value="{{mainMaterial}}" bindinput="onFieldInput" data-field="mainMaterial"/>
      </view>
      <view class="field-row">
        <view class="field half">
          <text class="label">重量</text>
          <input class="input num" type="digit" placeholder="500" value="{{mainWeight}}" bindinput="onFieldInput" data-field="mainWeight"/>
        </view>
        <view class="field half">
          <text class="label">单位</text>
          <view class="unit-wrap">
            <text wx:for="{{units}}" wx:key="*this"
                  data-field="mainUnit" data-val="{{item}}" bindtap="onFieldTap"
                  class="unit {{mainUnit === item ? 'on' : ''}}">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 配料清单 -->
    <view class="section-title">
      <text>配料清单</text>
      <text class="add-link" bindtap="addIngredient">+ 添加</text>
    </view>
    <block wx:for="{{ingredients}}" wx:key="idx">
      <view class="card ing-row">
        <view class="ing-header">
          <text class="ing-num">配料 {{index + 1}}</text>
          <text class="del" data-idx="{{index}}" bindtap="removeIngredient">删除</text>
        </view>
        <input class="input" placeholder="食材名称" value="{{item.material_name}}"
               data-idx="{{index}}" data-field="material_name" bindinput="onIngChange"/>
        <view class="ing-row-3">
          <input class="input sm" type="digit" placeholder="用量" value="{{item.base_amount}}"
                 data-idx="{{index}}" data-field="base_amount" bindinput="onIngChange"/>
          <input class="input sm" placeholder="单位" value="{{item.unit}}"
                 data-idx="{{index}}" data-field="unit" bindinput="onIngChange"/>
          <input class="input sm" type="digit" placeholder="单价" value="{{item.price_per_unit}}"
                 data-idx="{{index}}" data-field="price_per_unit" bindinput="onIngChange"/>
        </view>
      </view>
    </block>

    <!-- 做法步骤 -->
    <view class="section-title">
      <text>做法步骤</text>
      <text class="add-link" bindtap="addStep">+ 添加</text>
    </view>
    <block wx:for="{{steps}}" wx:key="idx">
      <view class="card step-row">
        <view class="step-header">
          <text class="step-num">步骤 {{index + 1}}</text>
          <text class="del" data-idx="{{index}}" bindtap="removeStep">删除</text>
        </view>
        <textarea class="textarea" placeholder="描述这一步..."
                  value="{{item.content}}"
                  data-idx="{{index}}" bindinput="onStepChange"/>
      </view>
    </block>

    <view style="height:200rpx"></view>
  </view>
</scroll-view>

<!-- 保存按钮 -->
<view class="bottom-bar">
  <button class="btn-primary full" bindtap="save" style="flex:1; margin:0;">保存菜谱</button>
</view>
