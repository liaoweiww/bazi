.page-header {
  padding: 40rpx 28rpx 10rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1C1C1E;
}

.material-card { padding: 20rpx 24rpx; }
.mat-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #F2F2F7;
}
.mat-info {
  flex: 1;
  min-width: 0;
}
.mat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.mat-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C1C1E;
}
.mat-cate {
  font-size: 24rpx;
  color: #007AFF;
  background: #007AFF10;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}
.mat-body { display: flex; justify-content: space-between; }
.mat-label { font-size: 24rpx; color: #8E8E93; display: block; }
.mat-val { font-size: 28rpx; font-weight: 600; color: #1C1C1E; }
.mat-date { font-size: 22rpx; color: #C7C7CC; display: block; }
