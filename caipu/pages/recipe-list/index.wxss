.page-header {
  padding: 40rpx 28rpx 10rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1C1C1E;
}
.icon-search {
  margin-right: 12rpx;
}

.recipe-card {
  padding: 24rpx 28rpx;
}
.card-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.recipe-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}
.card-body {
  flex: 1;
  min-width: 0;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.cate-tag {
  background: #F2F2F7;
  color: #007AFF;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.cook-info {
  font-size: 24rpx;
  color: #8E8E93;
}
.recipe-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12rpx;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.main-material {
  font-size: 26rpx;
  color: #8E8E93;
}
.cost {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF3B30;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #8E8E93;
  font-size: 30rpx;
  gap: 12rpx;
}
