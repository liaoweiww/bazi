<scroll-view scroll-y class="page" enable-back-to-top="true">

  <!-- 大标题 -->
  <view class="page-header">
    <text class="title">我的菜谱</text>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar">
    <text class="icon-search">🔍</text>
    <input placeholder="搜索菜名" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search"/>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="segment-wrap" scroll-x>
    <text class="seg {{activeCategory === item ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="*this"
          data-cat="{{item}}" bindtap="onCategoryTap">{{item}}</text>
  </scroll-view>

  <!-- 菜谱列表 -->
  <view class="recipe-list">
    <block wx:for="{{recipes}}" wx:key="id">
      <view class="card recipe-card" data-id="{{item.id}}" bindtap="onRecipeTap"
            bindlongpress="onDeleteRecipe">
        <view class="card-row">
          <image class="recipe-icon" src="{{item.icon_image || '/images/icon-add.png'}}" mode="aspectFill"/>
          <view class="card-body">
            <view class="card-header">
              <text class="cate-tag">{{item.category}}</text>
              <text class="cook-info">⏱ {{item.cook_time}}分钟 · ⭐ {{item.difficulty}} · {{item.base_person}}人份</text>
            </view>
            <text class="recipe-name">{{item.name}}</text>
            <view class="card-footer">
              <text class="main-material">主料：{{item.main_material}} {{item.main_weight}}{{item.main_unit}}</text>
              <text class="cost">约 ¥{{item.estimated_cost}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{recipes.length === 0}}">
      <view class="empty">
        <text>还没有菜谱</text>
        <text class="muted">点击右下角 + 开始创建</text>
      </view>
    </block>

    <!-- 底部留白 -->
    <view style="height:200rpx"></view>
  </view>
</scroll-view>

<!-- FAB -->
<view class="fab" bindtap="onAddTap">+</view>
