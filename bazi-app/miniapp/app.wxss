page{background:#0d0a05;color:#e8dfd4;font-size:14px;font-family:-apple-system,'PingFang SC','STKaiti',serif}
.gold{color:#c9a96e}.red{color:#b22222}.dim{color:#9a8e7e}.muted{color:#6b5e4e}.tc{text-align:center}
.card{background:linear-gradient(180deg,#1f1510,#261a12);border:1px solid #332418;border-radius:10px;padding:16px;margin-bottom:14px;position:relative;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.3)}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(201,169,110,.15),transparent)}
.ct{font-size:15px;color:#c9a96e;margin-bottom:12px;letter-spacing:2px;display:flex;align-items:center;gap:8px}
.ct::before{content:'';width:3px;height:15px;background:#c9a96e;border-radius:2px}
.fi{width:100%;padding:11px 14px;border:1px solid #332418;border-radius:7px;background:rgba(0,0,0,.25);color:#e8dfd4;font-size:15px;box-sizing:border-box}
.fi::placeholder{color:#6b5e4e}
.tog{display:flex;gap:8px}
.tog view{flex:1;padding:12px;border:1px solid #332418;border-radius:8px;background:rgba(0,0,0,.2);color:#9a8e7e;text-align:center;font-size:14px}
.tog view.on{border-color:#c9a96e;color:#e0c68c;background:rgba(201,169,110,.08)}
.dr{display:flex;gap:6px}.dr .fi{flex:1;text-align:center;padding:11px 4px}
.fg{margin-bottom:13px}.fl{display:block;font-size:11px;color:#e0c68c;margin-bottom:5px;letter-spacing:1px}
.btn{width:100%;padding:14px;border-radius:9px;font-size:17px;letter-spacing:6px;text-align:center}
.btn-go{background:linear-gradient(135deg,#8b1a1a,#b22222,#c44536);color:#fff;box-shadow:0 6px 24px rgba(178,34,34,.2)}
.btn-back{background:linear-gradient(135deg,#241812,#362418);color:#c9a96e;border:1px solid #4a3525;margin-top:12px}
.hide{display:none!important}.mb8{margin-bottom:8px}.mt8{margin-top:8px}
