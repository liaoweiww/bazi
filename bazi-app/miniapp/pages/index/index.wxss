.wrap{padding:10px 14px 20px;min-height:100vh}

/* ====== 顶部标题 ====== */
.hero{text-align:center;padding:30px 0 20px;position:relative}
.hero-bg{position:absolute;top:50%;left:50%;width:160px;height:160px;margin-left:-80px;margin-top:-80px}
.hero-ring{position:absolute;top:50%;left:50%;border-radius:50%;border-width:1px;border-style:solid}
.r1{width:160px;height:160px;margin-left:-80px;margin-top:-80px;border-color:rgba(201,169,110,.08)}
.r2{width:120px;height:120px;margin-left:-60px;margin-top:-60px;border-color:rgba(201,169,110,.12)}
.r3{width:80px;height:80px;margin-left:-40px;margin-top:-40px;border-color:rgba(201,169,110,.18)}
.hero-title{font-size:42px;color:#d4af37;font-weight:700;letter-spacing:12px;position:relative;text-shadow:0 2px 10px rgba(212,175,55,.2)}
.hero-sub{font-size:13px;color:#8b7355;letter-spacing:4px;position:relative;margin-top:8px}

/* ====== 太极图 ====== */
.bagua{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:18px}
.bline{width:40px;height:1px;background-color:rgba(201,169,110,.2)}
.yy-wrap{width:36px;height:36px;border-radius:50%;background-color:rgba(0,0,0,.2);border:1px solid rgba(201,169,110,.15);position:relative;overflow:hidden}
.yy-left{position:absolute;top:0;left:0;width:50%;height:100%;border-radius:100% 0 0 100%/50% 0 0 50%;background-color:rgba(201,169,110,.2)}
.yy-right{position:absolute;top:0;right:0;width:50%;height:100%;border-radius:0 100% 100% 0/0 50% 50% 0;background-color:rgba(139,115,85,.08)}

/* ====== 表单卡片 ====== */
.card{background:rgba(19,12,6,.6);border:1px solid #2a1f14;border-top:1px solid rgba(201,169,110,.15);border-radius:12px;padding:14px;margin-bottom:14px}

/* ====== 表单字段 ====== */
.fg{margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid rgba(51,36,24,.3)}
.fg:last-child{border-bottom:none;margin-bottom:0}
.fl{display:flex;align-items:center;gap:6px;margin-bottom:8px;font-size:14px;color:#c9a96e;letter-spacing:3px}
.fl-icon{font-size:16px}
.fi{width:100%;height:42px;background:rgba(0,0,0,.15);border:1px solid rgba(51,36,24,.4);border-radius:8px;padding:0 12px;font-size:14px;color:#f5f0e8;box-sizing:border-box}

/* ====== 日期行 ====== */
.dr{display:flex;gap:8px}
.dr .fi{flex:1;text-align:center}

/* ====== 切换按钮 ====== */
.tog{display:flex;gap:0;border-radius:8px;overflow:hidden;border:1px solid rgba(51,36,24,.4)}
.tog view{flex:1;text-align:center;padding:10px 0;font-size:13px;color:#9a8e7e;background:rgba(0,0,0,.1)}
.tog view.on{background:rgba(201,169,110,.1);color:#d4af37;font-weight:700}

/* ====== 排盘按钮 ====== */
.btn-go{background-color:#b22222;border-radius:12px;padding:16px;text-align:center;margin-top:16px;box-shadow:0 6px 20px rgba(139,0,0,.3)}
.btn-go-inner{display:flex;flex-direction:column;align-items:center}
.btn-go-main{font-size:20px;color:#e0c68c;font-weight:700;letter-spacing:8px}
.btn-go-sub{font-size:10px;color:rgba(224,198,140,.5);letter-spacing:4px;margin-top:2px}

/* ====== 脚注 ====== */
.foot{text-align:center;font-size:10px;color:#5a4a3a;padding:12px 0 20px;letter-spacing:2px}
