.wrap{width:100%;padding:8px 14px 20px;box-sizing:border-box;overflow-x:hidden}

/* ====== 卡片通用 ====== */
.card{background:rgba(19,12,6,.6);border:1px solid #2a1f14;border-top:1px solid rgba(201,169,110,.15);border-radius:10px;padding:14px;margin-bottom:10px;overflow:hidden}
.ct{text-align:center;font-size:17px;color:#d4af37;margin-bottom:10px;letter-spacing:4px;display:flex;align-items:center;justify-content:center;gap:6px}
.ct-icon{font-size:18px}
.ct-tap{position:relative;padding:4px 0}
.ct-tap:active{opacity:.7}
.ct-arrow{font-size:10px;color:#6b5e4e;margin-left:6px}
.gold{color:#d4af37}.dim{color:#9a8e7e}.muted{color:#6b5e4e}.red{color:#d44444}
.tc{text-align:center}.mt8{margin-top:8px}.mb8{margin-bottom:8px}

/* ====== 命盘 ====== */
.pgrid{display:flex;gap:5px}
.pc{flex:1;text-align:center;padding:10px 3px;border-radius:8px;background:rgba(0,0,0,.2);border:1px solid #332418}
.pc.dm{border-color:#b22222;box-shadow:0 0 14px rgba(178,34,34,.12);background:rgba(178,34,34,.06)}
.gz{font-size:24px;color:#e0c68c;font-weight:700;line-height:1.2}
.ss{font-size:10px;color:#d44444;margin:2px 0}.ny{font-size:9px;color:#6b5e4e}.cg{font-size:9px;color:#9a8e7e}
.dm-badge{display:inline-block;padding:1px 8px;background:#b22222;color:#fff;border-radius:9px;font-size:8px}
.dm-info{text-align:center;margin-top:8px;font-size:13px;color:#9a8e7e}

/* ====== 出生信息 ====== */
.ir{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(51,36,24,.4);font-size:13px}
.ir:last-child{border-bottom:none}

/* ====== 身强身弱标签 ====== */
.st-badge{display:inline-block;padding:6px 18px;border-radius:20px;font-size:15px;font-weight:700}
.st-s{background:rgba(178,34,34,.15);color:#d44444;border:1px solid rgba(178,34,34,.3)}
.st-w{background:rgba(74,112,152,.15);color:#7aa8d0;border:1px solid rgba(74,112,152,.3)}
.st-n{background:rgba(201,169,110,.1);color:#e0c68c;border:1px solid rgba(201,169,110,.3)}

/* ====== 标签 ====== */
.tags{display:flex;flex-wrap:wrap;gap:5px}
.tag{display:inline-flex;align-items:center;gap:3px;padding:4px 11px;border-radius:13px;font-size:11px}
.tag-y{background:rgba(196,69,54,.1);color:#d44444;border:1px solid rgba(196,69,54,.2)}
.tag-j{background:rgba(74,112,152,.1);color:#7aa8d0;border:1px solid rgba(74,112,152,.2)}
.dot{width:4px;height:4px;border-radius:50%;background:#d44444}
.tag-j .dot{background:#7aa8d0}

/* ====== 大运流年 ====== */
.dy-scroll{display:flex;gap:6px;white-space:nowrap;padding:4px 0}
.dy-node{min-width:64px;text-align:center;padding:10px 5px;border-radius:8px;background:rgba(0,0,0,.2);border:1px solid #332418}
.dy-node.cur{border-color:#c9a96e;background:rgba(201,169,110,.08);box-shadow:0 0 8px rgba(201,169,110,.1)}
.dy-node.sel{border-color:#d4af37;background:rgba(212,175,55,.12);box-shadow:0 0 10px rgba(212,175,55,.15)}
.dy-analysis{margin-top:12px;padding:12px;background:rgba(212,175,55,.04);border:1px solid rgba(212,175,55,.15);border-radius:8px;line-height:1.9}
.dy-ages{font-size:9px;color:#6b5e4e}.dy-gz{font-size:16px;color:#e0c68c;font-weight:700}.dy-ny{font-size:8px;color:#6b5e4e}
.ln-box{text-align:center;padding:14px;background:rgba(0,0,0,.12);border-radius:8px;border:1px dashed rgba(201,169,110,.15)}
.ln-gz{font-size:28px;color:#e0c68c;font-weight:700}

/* ====== 白话解读 ====== */
.vd{margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid rgba(51,36,24,.3);font-size:15px;line-height:1.9;color:#c0b090}
.vd:last-child{border-bottom:none}

/* ====== 年运分析 ====== */
.year-nav{display:flex;align-items:center;justify-content:center;gap:18px;margin-bottom:12px}
.year-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:rgba(201,169,110,.08);border:1px solid rgba(201,169,110,.2);border-radius:50%;color:#c9a96e;font-size:14px}
.year-num{font-size:24px;color:#e0c68c;font-weight:700}
.fn-gz{text-align:center;font-size:16px;color:#d4af37;margin-bottom:6px;letter-spacing:2px}
.fn-rating{display:inline-block;padding:3px 16px;border-radius:12px;font-size:12px;font-weight:700;margin-bottom:8px}
.rt-great{background:rgba(212,175,55,.15);color:#d4af37;border:1px solid rgba(212,175,55,.3)}
.rt-good{background:rgba(90,154,106,.12);color:#5a9a6a;border:1px solid rgba(90,154,106,.25)}
.rt-warn{background:rgba(196,30,58,.1);color:#e06070;border:1px solid rgba(196,30,58,.2)}
.rt-mid{background:rgba(139,115,85,.1);color:#8b7355;border:1px solid rgba(139,115,85,.2)}
.fn-text{font-size:14px;color:#c0b090;line-height:1.9}
.fn-dy{font-size:13px;color:#9a8e7e;margin-top:8px;padding:8px;background:rgba(0,0,0,.12);border-radius:6px;line-height:1.7}
.fn-rel{font-size:13px;color:#c9a96e;padding:4px 0;padding-left:10px;border-left:2px solid rgba(201,169,110,.3);margin-bottom:4px}
.fn-advice{font-size:14px;color:#f5f0e8;line-height:1.9;padding:10px;background:rgba(212,175,55,.06);border-radius:8px;border:1px solid rgba(212,175,55,.1)}

/* ====== 破解法 ====== */
.rem-block{margin-bottom:12px;padding:10px;background:rgba(0,0,0,.1);border-radius:8px;border-left:3px solid rgba(201,169,110,.25)}
.rem-title{font-size:13px;color:#d4af37;margin-bottom:4px;font-weight:700}
.rem-method{display:flex;align-items:flex-start;gap:6px;padding:5px 0;font-size:13px;color:#c0b090;line-height:1.6}
.rem-badge{font-size:9px;padding:1px 7px;border-radius:8px;background:rgba(201,169,110,.12);color:#c9a96e;border:1px solid rgba(201,169,110,.2);white-space:nowrap;flex-shrink:0}
.rem-badge-gen{background:rgba(90,154,106,.1);color:#5a9a6a;border:1px solid rgba(90,154,106,.2)}
.rem-mname{color:#e0c68c;white-space:nowrap;font-weight:700}

/* ====== 把控指南 ====== */
.ctrl-block{margin-bottom:14px;padding:10px;background:rgba(0,0,0,.1);border-radius:8px;border-left:3px solid rgba(74,112,152,.25)}
.ctrl-title{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.ctrl-icon-wrap{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:rgba(74,112,152,.1);border:1px solid rgba(74,112,152,.2);border-radius:8px;font-size:16px}
.ctrl-tips{margin-top:8px}
.ctrl-tip{font-size:13px;color:#9a8e7e;padding:3px 0;line-height:1.7;padding-left:14px}

/* ====== 参考书籍 ====== */
.book-card{display:flex;gap:12px;margin-bottom:10px}
.book-cover{width:44px;height:56px;display:flex;align-items:center;justify-content:center;background:rgba(201,169,110,.08);border:1px solid rgba(201,169,110,.2);border-radius:6px;font-size:22px;flex-shrink:0}
.book-info{flex:1}
.book-cat{display:inline-block;font-size:9px;padding:1px 8px;background:rgba(201,169,110,.08);border:1px solid rgba(201,169,110,.15);border-radius:6px;color:#c9a96e;margin-top:3px}
.book-detail{margin-bottom:8px}
.book-chapter{font-size:13px;color:#9a8e7e;padding:2px 0 2px 8px;line-height:1.6}
.book-quote{font-size:13px;color:#c9a96e;padding:3px 0 3px 10px;border-left:2px solid rgba(201,169,110,.2);margin-bottom:3px}
.book-reading{margin-top:6px;padding:8px;background:rgba(0,0,0,.1);border-radius:6px}
.book-divider{margin:10px 0;border-bottom:1px dashed rgba(51,36,24,.5)}

/* ====== 四大运势总结 ====== */
.life-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.life-tag{font-size:11px;padding:3px 10px;border-radius:10px}
.tag-yl{background:rgba(212,175,55,.1);color:#d4af37;border:1px solid rgba(212,175,55,.2)}
.tag-yg{background:rgba(90,154,106,.1);color:#5a9a6a;border:1px solid rgba(90,154,106,.2)}
.tag-yr{background:rgba(196,30,58,.1);color:#e06070;border:1px solid rgba(196,30,58,.2)}
.tag-yb{background:rgba(74,112,152,.1);color:#7aa8d0;border:1px solid rgba(74,112,152,.2)}
.life-block{margin-bottom:14px;padding:12px;background:rgba(0,0,0,.12);border-radius:8px;border-left:3px solid rgba(201,169,110,.15)}
.life-title{font-size:16px;color:#d4af37;margin-bottom:8px;font-weight:700}

/* ====== 按钮 ====== */
.btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:14px;border-radius:10px;font-size:15px;text-align:center;margin-top:12px}
.btn-back{background:rgba(201,169,110,.08);border:1px solid rgba(201,169,110,.2);color:#c9a96e}
.btn-icon{font-size:16px}
