.wrap{width:100%;padding:var(--spacing-page-padding);box-sizing:border-box;overflow-x:hidden;background:var(--bg-root);color:var(--text-primary);font-size:var(--font-size-body);font-family:var(--font-family-base)}

/* ====== 卡片通用 ====== */
.card{background:var(--bg-card);border:var(--border-width-card) var(--border-style-card) var(--border-color);border-radius:var(--radius-card);padding:var(--spacing-card-padding);margin-bottom:var(--spacing-section-gap);overflow:hidden;position:relative;box-shadow:var(--shadow-card)}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:var(--decoration-card-accent-line);background:linear-gradient(90deg,transparent,var(--accent-15),transparent)}
.card::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;border-radius:var(--radius-card);pointer-events:none;box-shadow:var(--decoration-card-inner-glow)}
.ct{text-align:center;font-size:var(--font-size-title);font-weight:var(--font-weight-title);color:var(--accent-light);margin-bottom:var(--spacing-card-inner-gap);letter-spacing:2px;display:flex;align-items:center;justify-content:center;gap:6px}
.ct-icon{font-size:18px}
.ct-tap{position:relative;padding:4px 0}
.ct-tap:active{opacity:.7}
.ct-arrow{font-size:10px;color:var(--text-muted);margin-left:6px}
.gold{color:var(--accent-light)}.dim{color:var(--text-body)}.muted{color:var(--text-muted)}.red{color:var(--vermillion-light)}
.tc{text-align:center}.mt8{margin-top:8px}.mb8{margin-bottom:8px}

/* ====== 主题专属卡片 ====== */
.theme-imperial .card{border:2px solid var(--border-color);box-shadow:0 0 0 1px var(--accent-10)}
.theme-celadon .card::before{background:linear-gradient(90deg,transparent 0%,var(--accent-08) 20%,var(--accent-15) 50%,var(--accent-08) 80%,transparent 100%);border-radius:0 0 50% 50%}

/* ====== 命盘 ====== */
.pgrid{display:flex;gap:5px}
.pc{flex:1;text-align:center;padding:10px 3px;border-radius:var(--radius-card);background:var(--bg-input);border:1px solid var(--border-color)}
.pc.dm{border-color:var(--vermillion);box-shadow:0 0 14px var(--vermillion-12);background:var(--vermillion-06)}
.gz{font-size:var(--font-size-display);color:var(--accent-light);font-weight:var(--font-weight-hero);line-height:1.2}
.ss{font-size:10px;color:var(--vermillion-light);margin:2px 0}.ny{font-size:9px;color:var(--text-muted)}.cg{font-size:9px;color:var(--text-body)}
.dm-badge{display:inline-block;padding:1px 8px;background:var(--vermillion);color:#fff;border-radius:var(--radius-tag);font-size:var(--font-size-caption)}
.dm-info{text-align:center;margin-top:8px;font-size:var(--font-size-caption);color:var(--text-body)}

/* ====== 出生信息 ====== */
.ir{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border-40);font-size:var(--font-size-caption)}
.ir:last-child{border-bottom:none}

/* ====== 身强身弱标签 ====== */
.st-badge{display:inline-block;padding:6px 18px;border-radius:20px;font-size:15px;font-weight:var(--font-weight-strong)}
.st-s{background:var(--vermillion-15);color:var(--vermillion-light);border:1px solid var(--vermillion-30)}
.st-w{background:var(--color-blue-bg);color:var(--color-blue);border:1px solid var(--color-blue-border)}
.st-n{background:var(--accent-10);color:var(--accent-light);border:1px solid var(--accent-30)}

/* ====== 标签 ====== */
.tags{display:flex;flex-wrap:wrap;gap:5px}
.tag{display:inline-flex;align-items:center;gap:3px;padding:4px 11px;border-radius:var(--radius-tag);font-size:var(--font-size-caption)}
.tag-y{background:var(--vermillion-10);color:var(--vermillion-light);border:1px solid var(--vermillion-20)}
.tag-j{background:var(--color-blue-bg);color:var(--color-blue);border:1px solid var(--color-blue-border)}
.dot{width:4px;height:4px;border-radius:50%;background:var(--vermillion-light)}
.tag-j .dot{background:var(--color-blue)}

/* ====== 五行力量 ====== */
.wx-label{width:20px;font-size:var(--font-size-body);text-align:center}
.wx-jin{color:var(--wx-metal)}
.wx-mu{color:var(--wx-wood)}
.wx-shui{color:var(--wx-water)}
.wx-huo{color:var(--wx-fire)}
.wx-tu{color:var(--wx-earth)}
.wx-bar-track{flex:1;height:8px;background:var(--bg-input);border-radius:4px;overflow:hidden}
.wx-bar-fill{height:100%;border-radius:4px}
.wx-bar-fill.wx-jin{background:var(--wx-metal)}
.wx-bar-fill.wx-mu{background:var(--wx-wood)}
.wx-bar-fill.wx-shui{background:var(--wx-water)}
.wx-bar-fill.wx-huo{background:var(--wx-fire)}
.wx-bar-fill.wx-tu{background:var(--wx-earth)}
.wx-score{font-size:var(--font-size-caption);color:var(--text-muted);width:30px}

/* ====== 大运流年 ====== */
.dy-scroll{display:flex;gap:6px;white-space:nowrap;padding:4px 0}
.dy-node{min-width:64px;text-align:center;padding:10px 5px;border-radius:var(--radius-card);background:var(--bg-input);border:1px solid var(--border-color)}
.dy-node.cur{border-color:var(--accent);background:var(--accent-08);box-shadow:0 0 8px var(--accent-10)}
.dy-node.sel{border-color:var(--accent-light);background:var(--accent-12);box-shadow:0 0 10px var(--accent-15)}
.dy-analysis{margin-top:12px;padding:12px;background:var(--accent-04);border:1px solid var(--accent-15);border-radius:var(--radius-card);line-height:1.9}
.dy-ages{font-size:9px;color:var(--text-muted)}.dy-gz{font-size:var(--font-size-display);color:var(--accent-light);font-weight:var(--font-weight-strong)}.dy-ny{font-size:8px;color:var(--text-muted)}
.ln-box{text-align:center;padding:14px;background:var(--bg-input);border-radius:var(--radius-card);border:1px dashed var(--accent-15)}
.ln-gz{font-size:28px;color:var(--accent-light);font-weight:var(--font-weight-strong)}

/* ====== 白话解读 ====== */
.vd{margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border-40);font-size:var(--font-size-body);line-height:1.9;color:var(--text-body)}
.vd:last-child{border-bottom:none}

/* ====== 年运分析 ====== */
.year-nav{display:flex;align-items:center;justify-content:center;gap:18px;margin-bottom:12px}
.year-btn{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--accent-08);border:1px solid var(--accent-20);border-radius:50%;color:var(--accent);font-size:14px}
.year-num{font-size:24px;color:var(--accent-light);font-weight:var(--font-weight-strong)}
.fn-gz{text-align:center;font-size:var(--font-size-display);color:var(--accent-light);margin-bottom:6px;letter-spacing:2px}
.fn-rating{display:inline-block;padding:3px 16px;border-radius:12px;font-size:var(--font-size-caption);font-weight:var(--font-weight-strong);margin-bottom:8px}
.rt-great{background:var(--accent-15);color:var(--accent-light);border:1px solid var(--accent-30)}
.rt-good{background:rgba(90,154,106,.12);color:var(--color-positive);border:1px solid rgba(90,154,106,.25)}
.rt-warn{background:var(--vermillion-10);color:var(--vermillion-light);border:1px solid var(--vermillion-20)}
.rt-mid{background:var(--accent-10);color:var(--text-muted);border:1px solid var(--accent-20)}
.fn-text{font-size:var(--font-size-body);color:var(--text-body);line-height:1.9}
.fn-dy{font-size:var(--font-size-caption);color:var(--text-body);margin-top:8px;padding:8px;background:var(--bg-input);border-radius:6px;line-height:1.7}
.fn-rel{font-size:var(--font-size-caption);color:var(--accent);padding:4px 0;padding-left:10px;border-left:2px solid var(--accent-30);margin-bottom:4px}
.fn-advice{font-size:var(--font-size-body);color:var(--text-primary);line-height:1.9;padding:10px;background:var(--accent-06);border-radius:8px;border:1px solid var(--accent-10)}

/* ====== 破解法 ====== */
.rem-block{margin-bottom:12px;padding:10px;background:var(--bg-input);border-radius:var(--radius-card);border-left:3px solid var(--accent-25)}
.rem-title{font-size:var(--font-size-caption);color:var(--accent-light);margin-bottom:4px;font-weight:var(--font-weight-strong)}
.rem-method{display:flex;align-items:flex-start;gap:6px;padding:5px 0;font-size:var(--font-size-caption);color:var(--text-body);line-height:1.6}
.rem-badge{font-size:9px;padding:1px 7px;border-radius:var(--radius-tag);background:var(--accent-12);color:var(--accent);border:1px solid var(--accent-20);white-space:nowrap;flex-shrink:0}
.rem-badge-gen{background:rgba(90,154,106,.1);color:var(--color-positive);border:1px solid rgba(90,154,106,.2)}
.rem-mname{color:var(--accent-light);white-space:nowrap;font-weight:var(--font-weight-strong)}

/* ====== 把控指南 ====== */
.ctrl-block{margin-bottom:14px;padding:10px;background:var(--bg-input);border-radius:var(--radius-card);border-left:3px solid var(--color-blue-border)}
.ctrl-title{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.ctrl-icon-wrap{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:var(--color-blue-bg);border:1px solid var(--color-blue-border);border-radius:var(--radius-card);font-size:16px}
.ctrl-tips{margin-top:8px}
.ctrl-tip{font-size:var(--font-size-caption);color:var(--text-body);padding:3px 0;line-height:1.7;padding-left:14px}

/* ====== 参考书籍 ====== */
.book-card{display:flex;gap:12px;margin-bottom:10px}
.book-cover{width:44px;height:56px;display:flex;align-items:center;justify-content:center;background:var(--accent-08);border:1px solid var(--accent-20);border-radius:var(--radius-card);font-size:22px;flex-shrink:0}
.book-info{flex:1}
.book-cat{display:inline-block;font-size:9px;padding:1px 8px;background:var(--accent-08);border:1px solid var(--accent-15);border-radius:var(--radius-tag);color:var(--accent);margin-top:3px}
.book-detail{margin-bottom:8px}
.book-chapter{font-size:var(--font-size-caption);color:var(--text-body);padding:2px 0 2px 8px;line-height:1.6}
.book-quote{font-size:var(--font-size-caption);color:var(--accent);padding:3px 0 3px 10px;border-left:2px solid var(--accent-20);margin-bottom:3px}
.book-reading{margin-top:6px;padding:8px;background:var(--bg-input);border-radius:var(--radius-card)}
.book-divider{margin:10px 0;border-bottom:1px dashed var(--border-50)}

/* ====== 四大运势总结 ====== */
.life-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.life-tag{font-size:var(--font-size-caption);padding:3px 10px;border-radius:var(--radius-tag)}
.tag-yl{background:var(--accent-10);color:var(--accent-light);border:1px solid var(--accent-20)}
.tag-yg{background:rgba(90,154,106,.1);color:var(--color-positive);border:1px solid rgba(90,154,106,.2)}
.tag-yr{background:var(--vermillion-10);color:var(--vermillion-light);border:1px solid var(--vermillion-20)}
.tag-yb{background:var(--color-blue-bg);color:var(--color-blue);border:1px solid var(--color-blue-border)}
.life-block{margin-bottom:14px;padding:12px;background:var(--bg-input);border-radius:var(--radius-card);border-left:3px solid var(--accent-15)}
.life-title{font-size:16px;color:var(--accent-light);margin-bottom:8px;font-weight:var(--font-weight-strong)}

/* ====== 按钮 ====== */
.btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:var(--spacing-btn-padding);border-radius:var(--radius-btn);font-size:var(--font-size-body);text-align:center;margin-top:12px}
.btn-back{background:var(--accent-08);border:1px solid var(--accent-20);color:var(--accent)}
.btn-icon{font-size:16px}
