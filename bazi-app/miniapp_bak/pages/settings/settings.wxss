.wrap{width:100%;padding:var(--spacing-page-padding);min-height:100vh;box-sizing:border-box;background:var(--bg-root);color:var(--text-primary);font-size:var(--font-size-body);font-family:var(--font-family-base)}

.section-title{font-size:var(--font-size-title);font-weight:var(--font-weight-title);letter-spacing:4px;display:flex;align-items:center;gap:8px;margin-bottom:4px;color:var(--accent-light)}
.st-icon{font-size:20px}
.desc{font-size:var(--font-size-caption);color:var(--text-muted);margin-bottom:16px;letter-spacing:1px}

.theme-list{display:flex;flex-direction:column;gap:var(--spacing-section-gap)}

.theme-card{display:flex;gap:12px;padding:14px;border-radius:var(--radius-card);background:var(--bg-card);border:var(--border-width-card) var(--border-style-card) var(--border-color);transition:all 0.2s}
.theme-card.active{border-color:var(--accent-light);background:var(--accent-08);box-shadow:var(--shadow-glow)}
.theme-card:active{opacity:0.8}

.tc-preview{flex-shrink:0}
.tc-swatch{width:52px;height:62px;border-radius:var(--radius-card);border:1px solid var(--border-light);overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;align-items:stretch;position:relative}
.tc-bar{width:100%;height:10px;border-radius:0 0 6px 6px;flex-shrink:0}

/* 微型装饰预览 */
.tp-mini{position:absolute;top:6px;left:6px;right:6px;bottom:14px;display:flex;align-items:center;justify-content:center}
.tp-mini-classic{flex-direction:column;gap:3px}
.tpmr1{width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,.15)}
.tpmr2{width:18px;height:18px;border-radius:50%;border:1px solid rgba(255,255,255,.25)}
.tp-mini-ink{gap:5px;align-items:flex-start}
.tpmi-dot{width:12px;height:12px;border-radius:50%;background:radial-gradient(circle at 40% 40%,rgba(255,255,255,.2),transparent 70%)}
.tpmi-line{width:1px;height:22px;background:linear-gradient(to bottom,rgba(255,255,255,.12),transparent)}
.tp-mini-imp{flex-direction:column}
.tpmf-box{width:32px;height:28px;border:1px solid rgba(255,255,255,.2);position:relative}
.tpmf-dot{position:absolute;width:4px;height:4px;background:rgba(255,255,255,.3)}
.tpmf-d1{top:-1px;left:-1px}.tpmf-d2{top:-1px;right:-1px}.tpmf-d3{bottom:-1px;left:-1px}.tpmf-d4{bottom:-1px;right:-1px}
.tp-mini-ce{flex-direction:column;justify-content:flex-end}
.tpmc-wave{width:100%;height:8px;background:radial-gradient(ellipse at 30% 100%,rgba(255,255,255,.15),transparent 45%),radial-gradient(ellipse at 70% 100%,rgba(255,255,255,.15),transparent 45%)}

.tc-info{flex:1;display:flex;flex-direction:column;gap:2px;justify-content:center}
.tc-name{font-size:var(--font-size-title);font-weight:var(--font-weight-title);color:var(--text-primary);display:flex;align-items:center;gap:6px}
.tc-check{font-size:14px;color:var(--accent-light)}
.tc-sub{font-size:var(--font-size-caption);color:var(--text-muted)}
.tc-desc{font-size:var(--font-size-caption);color:var(--text-body)}
.tc-typo{margin-top:6px;font-size:20rpx;color:var(--accent-light);letter-spacing:4rpx;opacity:0.7}

.btn-back-wrap{margin-top:20px}
.btn-back{display:block;text-align:center;padding:var(--spacing-btn-padding);border-radius:var(--radius-btn);font-size:var(--font-size-body);color:var(--accent);background:var(--accent-08);border:1px solid var(--accent-15)}
